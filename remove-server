#!/bin/bash

# List existing server ports with their root directories
echo "Existing Nginx server configurations:"
echo "--------------------------------------"
for config in /etc/nginx/sites-available/*; do
    if [ -f "$config" ]; then
        ports=$(grep "listen " "$config" | awk '{print $2}' | sed 's/;//')
        root_dir=$(grep -m 1 "root" "$config" | awk '{print $2}' | sed 's/;//')
        dir_name=$(basename "$root_dir")
        server_name=$(grep -m 1 "server_name" "$config" | awk '{print $2}' | sed 's/;//')
        
        for port in $ports; do
            echo -e "\e[36mPort: $port | Directory: $dir_name\e[0m"
        done
        fi
        done
        echo "--------------------------------------"

        # Prompt for the port number
        read -p "Enter the port number to delete its configuration: " port_number

        # Find the Nginx config file based on the port number
        config_file=$(grep -l "listen $port_number;" /etc/nginx/sites-available/*)

        # Check if the config file exists
        if [ -n "$config_file" ]; then
        server_name=$(basename "$config_file")
        root_dir=$(grep -m 1 "root" "$config_file" | awk '{print $2}' | sed 's/;//')
        dir_name=$(basename "$root_dir")
        
        # Remove the symbolic link in sites-enabled
        sudo rm -f "/etc/nginx/sites-enabled/$server_name"

        # Delete the Nginx config file
        sudo rm -f "$config_file"

        # Test Nginx configuration
        sudo nginx -t

        # If the test is successful, restart Nginx
        if [ $? -eq 0 ]; then
        echo "Nginx configuration is valid. Restarting Nginx..."
        sudo systemctl restart nginx
        echo -e "Nginx configuration for port $port_number (serving \e[36m$dir_name\e[0m) has been deleted successfully."
        else
        echo "Error in Nginx configuration. Please check the output above."
        fi
        else
        echo "No Nginx configuration file found for port $port_number."
        fi
